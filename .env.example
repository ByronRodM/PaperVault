# Copia este archivo como .env y reemplaza los valores con tus credenciales reales.
# El .env real nunca debe subirse al repositorio (ya está en .gitignore).

DB_USER=USUARIO
DB_PASSWORD=CONTRASEÑA_SEGURA
DB_NAME=papervault

# Debe coincidir con DB_USER, DB_PASSWORD, DB_NAME y el puerto del docker-compose.yml
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA_SEGURA@localhost:15432/papervault

# Debe ser una cadena aleatoria larga y segura para proteger la sesión de la aplicación,
# generada con "python -c 'import secrets; print(secrets.token_urlsafe(48))'"
# La aplicación no arranca si falta o tiene menos de 32 caracteres.
SESSION_SECRET=VALOR_SEGURO_PARA_LA_SESION

# Poner en 1 cuando la aplicación se sirva detrás de HTTPS (activa la cookie Secure y HSTS).
SESSION_HTTPS=0
