# Copia este archivo como .env y reemplaza los valores con tus credenciales reales.
# El .env real nunca debe subirse al repositorio (ya está en .gitignore).

DB_USER=USUARIO
DB_PASSWORD=CONTRASEÑA_SEGURA
DB_NAME=papervault

# Debe coincidir con DB_USER, DB_PASSWORD, DB_NAME y el puerto del docker-compose.yml
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA_SEGURA@localhost:15432/papervault
